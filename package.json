{
  "name": "serialterminal-share",
  "displayName": "Serial Terminal Share",
  "publisher": "sightsnow",
  "version": "0.2.0",
  "description": "An interactive serial terminal tool",
  "extensionKind": [
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sightsnow/vscode-serial-terminal.git"
  },
  "homepage": "https://github.com/sightsnow/vscode-serial-terminal/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/sightsnow/vscode-serial-terminal/issues"
  },
  "icon": "assets/serial-share.png",
  "l10n": "./l10n",
  "keywords": [
    "serial port",
    "serial",
    "com",
    "terminal",
    "console",
    "uart"
  ],
  "pricing": "Free",
  "engines": {
    "vscode": "^1.76.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionPack": [
    "awsxxf.scriptnotebook"
  ],
  "extensionDependencies": [
    "awsxxf.scriptnotebook"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serial-terminal-share-sidebar",
          "title": "%entryView.title%",
          "icon": "$(debug-disconnect)"
        }
      ]
    },
    "views": {
      "serial-terminal-share-sidebar": [
        {
          "name": "%TreeView.serialPorts%",
          "id": "serialTerminalShare.availablePorts",
          "initialSize": 20
        },
        {
          "name": "%TreeView.logs%",
          "id": "serialTerminalShare.logs",
          "initialSize": 50
        },
        {
          "name": "%TreeView.scriptsNotebooks%",
          "id": "serialTerminalShare.scriptsNotebooks",
          "initialSize": 20
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "serialPortTerminal",
          "title": "%serialPortTerminal%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "serialTerminalShare.serialView.refresh",
          "when": "view == serialTerminalShare.availablePorts",
          "group": "navigation@2"
        },
        {
          "command": "serialTerminalShare.setting.SerialPort",
          "when": "view == serialTerminalShare.availablePorts",
          "group": "navigation@1"
        },
        {
          "command": "serialTerminalShare.setting.Log",
          "when": "view == serialTerminalShare.logs",
          "group": "navigation@1"
        },
        {
          "command": "serialTerminalShare.logView.revealLogs",
          "when": "view == serialTerminalShare.logs",
          "group": "navigation@2"
        },
        {
          "command": "serialTerminalShare.scriptView.newNotebook",
          "when": "view == serialTerminalShare.scriptsNotebooks",
          "group": "navigation@1"
        },
        {
          "command": "serialTerminalShare.setting.Notebook",
          "when": "view == serialTerminalShare.scriptsNotebooks",
          "group": "navigation@2"
        },
        {
          "command": "serialTerminalShare.scriptView.revealNotebooks",
          "when": "view == serialTerminalShare.scriptsNotebooks",
          "group": "navigation@4"
        },
        {
          "command": "serialTerminalShare.terminal.startSaveLog",
          "when": "view == terminal && serialTerminalShare.terminal.focus && !serialTerminalShare.terminal.recordingLog",
          "group": "navigation"
        },
        {
          "command": "serialTerminalShare.terminal.stopSaveLog",
          "when": "view == terminal && serialTerminalShare.terminal.focus && serialTerminalShare.terminal.recordingLog",
          "group": "navigation"
        },
        {
          "command": "serialTerminalShare.terminal.clear",
          "when": "view == terminal && serialTerminalShare.terminal.focus",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "serialTerminalShare.serialView.open",
          "when": "view == serialTerminalShare.availablePorts",
          "group": "inline"
        },
        {
          "command": "serialTerminalShare.treeItem.revealInExplorer",
          "when": "view == serialTerminalShare.logs || view == serialTerminalShare.scriptsNotebooks",
          "group": "navigation@1"
        },
        {
          "command": "serialTerminalShare.treeItem.deleteResource",
          "when": "view == serialTerminalShare.logs || view == serialTerminalShare.scriptsNotebooks",
          "group": "navigation@2"
        }
      ]
    },
    "commands": [
      {
        "command": "serialTerminalShare.agentPrompt",
        "title": "AI Usage Prompt",
        "category": "Serial Terminal Share"
      },
      {
        "command": "serialTerminalShare.terminal.startSaveLog",
        "icon": "$(save-as)",
        "title": "%commands.terminal.startSaveLog%"
      },
      {
        "command": "serialTerminalShare.terminal.stopSaveLog",
        "icon": "$(stop-circle)",
        "title": "%commands.terminal.stopSaveLog%"
      },
      {
        "command": "serialTerminalShare.terminal.clear",
        "icon": "$(clear-all)",
        "enablement": "serialTerminalShare.terminal.focus",
        "title": "%commands.terminal.clear%"
      },
      {
        "command": "serialTerminalShare.setting.SerialPort",
        "icon": "$(gear)",
        "title": "%commands.setting.SerialPort%"
      },
      {
        "command": "serialTerminalShare.setting.Log",
        "icon": "$(gear)",
        "title": "%commands.setting.Log%"
      },
      {
        "command": "serialTerminalShare.setting.Notebook",
        "icon": "$(gear)",
        "title": "%commands.setting.Notebook%"
      },
      {
        "icon": "$(arrow-right)",
        "command": "serialTerminalShare.treeItem.openOnEditor",
        "title": "%commands.treeItem.openOnEditor%"
      },
      {
        "command": "serialTerminalShare.treeItem.revealInExplorer",
        "icon": "$(file-directory)",
        "title": "%commands.treeItem.revealInExplorer%"
      },
      {
        "command": "serialTerminalShare.treeItem.deleteResource",
        "icon": "$(trash)",
        "title": "%commands.treeItem.deleteResource%"
      },
      {
        "command": "serialTerminalShare.serialView.open",
        "icon": "$(arrow-right)",
        "title": "%commands.serialView.open%"
      },
      {
        "command": "serialTerminalShare.serialView.refresh",
        "icon": "$(sync)",
        "title": "%commands.serialView.refresh%"
      },
      {
        "command": "serialTerminalShare.logView.openOnEditor",
        "title": "%commands.logView.openOnEditor%"
      },
      {
        "command": "serialTerminalShare.logView.revealLogs",
        "icon": "$(file-directory)",
        "title": "%commands.logView.revealLogs%"
      },
      {
        "command": "serialTerminalShare.scriptView.newNotebook",
        "icon": "$(new-file)",
        "title": "%commands.scriptView.newNotebook%"
      },
      {
        "command": "serialTerminalShare.scriptView.revealNotebooks",
        "icon": "$(file-directory)",
        "title": "%commands.scriptView.revealNotebooks%"
      }
    ],
    "configuration": {
      "title": "%setting.title%",
      "properties": {
        "SerialTerminalShare.serialPort.configurations": {
          "title": "%setting.serialPort.configurations.title%",
          "type": "array",
          "default": [
            "115200n1",
            "9600n1",
            "19200n1",
            "38400n1",
            "76800n1",
            "153600n1",
            "460800n1",
            "921600n1",
            "2000000n1"
          ],
          "items": {
            "type": "string",
            "pattern": "^(\\d+)((n|e|o)([5678])?(1|1.5|2)?)?$"
          },
          "markdownDescription": "%setting.serialPort.configurations.description%"
        },
        "SerialTerminalShare.log.savePath": {
          "title": "%setting.log.savePath.title%",
          "type": "string",
          "markdownDescription": "%setting.log.savePath.description%"
        },
        "SerialTerminalShare.log.autoSave": {
          "title": "%setting.log.autoSave.title%",
          "type": "boolean",
          "default": false,
          "markdownDescription": "%setting.log.autoSave.description%"
        },
        "SerialTerminalShare.log.timestamp.enable": {
          "title": "%setting.log.timestamp.enable.title%",
          "type": "boolean",
          "default": false,
          "markdownDescription": "%setting.log.timestamp.enable.description%"
        },
        "SerialTerminalShare.log.timestamp.duration": {
          "title": "%setting.log.timestamp.duration.title%",
          "type": "number",
          "default": 20000000,
          "markdownDescription": "%setting.log.timestamp.duration.description%"
        },
        "SerialTerminalShare.notebook.savePath": {
          "title": "%setting.notebook.savePath.title%",
          "type": "string",
          "markdownDescription": "%setting.notebook.savePath.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run package:companion",
    "package:companion": "cd companion && vsce package --out ../bundled-companion.vsix",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "@types/vscode": "1.76.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vscode/l10n-dev": "^0.0.26",
    "@vscode/test-electron": "^2.5.2",
    "electron": "^25.9.8",
    "eslint": "^8.57.1",
    "glob": "^8.1.0",
    "mocha": "^10.8.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "colors": "^1.4.0",
    "serialport": "^13.0.0"
  },
  "overrides": {
    "serialport": {
      "@serialport/bindings-cpp": "npm:@littrick/serialport-bindings-cpp@1.0.1"
    }
  }
}
